    "promptSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Promptsha256",
      "type": "string"
    },
    "promptVersion": {
      "title": "Promptversion",
      "type": "string"
    },
    "provider": {
      "title": "Provider",
      "type": "string"
    },
    "rawResponsePath": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rawresponsepath"
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Requestid"
    },
    "requestedModel": {
      "title": "Requestedmodel",
      "type": "string"
    },
    "result": {
      "anyOf": [
        {
          "$ref": "#/$defs/EnrichmentResult"
        },
        {
          "type": "null"
        }
      ],
      "default": null
