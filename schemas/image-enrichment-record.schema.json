        },
        "recoveryMode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recoverymode"
        },
        "requestId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requestid"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "structuredRetryNumber": {
          "minimum": 0,
          "title": "Structuredretrynumber",
          "type": "integer"
        },
        "transportRetryNumber": {
          "minimum": 0,
          "title": "Transportretrynumber",
          "type": "integer"
        },
        "usage": {
          "anyOf": [
            {
              "$ref": "#/$defs/Usage"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "validationIssues": {
          "anyOf": [
            {
              "items": {
                "additionalProperties": true,
                "type": "object"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validationissues"
        },
        "validationStatus": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validationstatus"
        }
      },
      "required": [
        "attemptNumber",
        "structuredRetryNumber",
        "transportRetryNumber",
        "status",
        "providerResponseReceived"
