          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartContent": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/ChartAxis"
          },
          "title": "Axes",
          "type": "array"
        },
        "directObservations": {
          "items": {
            "type": "string"
          },
          "title": "Directobservations",
          "type": "array"
        },
        "inferences": {
          "items": {
            "type": "string"
          },
          "title": "Inferences",
          "type": "array"
        },
        "keyValues": {
          "items": {
            "type": "string"
          },
          "title": "Keyvalues",
          "type": "array"
        },
        "legends": {
          "items": {
            "type": "string"
          },
          "title": "Legends",
          "type": "array"
        },
        "series": {
          "items": {
            "type": "string"
          },
          "title": "Series",
          "type": "array"
        },
        "textualClaims": {
          "items": {
            "type": "string"
          },
          "title": "Textualclaims",
          "type": "array"
        },
        "trends": {
          "items": {
            "type": "string"
          },
          "title": "Trends",
          "type": "array"
        }
      },
      "title": "ChartContent",
      "type": "object"
    },
    "CodeContent": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CodeContent",
      "type": "object"
    },
    "EnrichmentAction": {
      "enum": [
        "exclude_from_retrieval",
        "describe",
        "transcribe_text",
        "transcribe_code",
        "extract_table",
        "understand_chart",
        "ocr_and_vision",
        "decode_qr",
        "manual_review"
      ],
      "title": "EnrichmentAction",
      "type": "string"
    },
    "EnrichmentAttemptRecord": {
      "additionalProperties": false,
      "description": "One actual provider call made for an image task.",
      "properties": {
        "actualModel": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actualmodel"
        },
        "attemptNumber": {
          "minimum": 1,
          "title": "Attemptnumber",
          "type": "integer"
        },
        "completedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Completedat"
        },
        "elapsedMs": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Elapsedms"
        },
        "errorCode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errorcode"
        },
        "errorMessage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Errormessage"
        },
        "finishReason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finishreason"
        },
        "providerResponseReceived": {
          "title": "Providerresponsereceived",
          "type": "boolean"
        },
        "rawResponsePath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rawresponsepath"
        },
        "recoveryDetailsPath": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
