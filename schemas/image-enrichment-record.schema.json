        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "extractedText": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extractedtext"
        },
        "imageType": {
          "$ref": "#/$defs/ImageType"
        },
        "keyFacts": {
          "items": {
            "type": "string"
          },
          "title": "Keyfacts",
          "type": "array"
        },
        "knowledgeValue": {
          "$ref": "#/$defs/KnowledgeValue"
        },
        "retrievalDecision": {
          "$ref": "#/$defs/RetrievalDecision"
        },
        "schemaVersion": {
          "const": "1.0.0",
          "title": "Schemaversion",
          "type": "string"
        },
        "table": {
          "anyOf": [
            {
              "$ref": "#/$defs/TableContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
