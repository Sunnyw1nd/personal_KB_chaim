      "title": "EnrichmentResult",
      "type": "object"
    },
    "ImageType": {
      "enum": [
        "architecture_flow",
        "table",
        "chart",
        "code",
        "ui_screenshot",
        "text_image",
        "decorative_text",
        "qr_code",
        "photo_scene",
        "logo_mark",
        "other"
      ],
      "title": "ImageType",
      "type": "string"
    },
    "KnowledgeValue": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "context_dependent"
      ],
      "title": "KnowledgeValue",
      "type": "string"
    },
    "RetrievalDecision": {
      "enum": [
        "include",
        "exclude",
        "manual_review"
      ],
      "title": "RetrievalDecision",
      "type": "string"
    },
    "ReviewStatus": {
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    },
    "RunStatus": {
      "enum": [
        "success",
        "cached",
        "dry_run",
        "policy_rejected",
        "skipped",
        "invalid_output",
        "timeout",
        "rate_limited",
        "authentication_failed",
        "provider_error"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "TableContent": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "mergedCells": {
          "items": {
            "type": "string"
          },
          "title": "Mergedcells",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "textRepresentation": {
          "minLength": 1,
          "title": "Textrepresentation",
          "type": "string"
        }
      },
      "required": [
        "textRepresentation"
      ],
      "title": "TableContent",
      "type": "object"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cachedInputTokens": {
          "anyOf": [
            {
              "minimum": 0,
