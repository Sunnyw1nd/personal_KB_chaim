    "EnrichmentResult": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "$ref": "#/$defs/EnrichmentAction"
        },
        "chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/ChartContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
