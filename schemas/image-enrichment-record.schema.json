    "resultSchemaVersion": {
      "title": "Resultschemaversion",
      "type": "string"
    },
    "retryCount": {
      "minimum": 0,
      "title": "Retrycount",
      "type": "integer"
    },
    "reviewStatus": {
      "anyOf": [
        {
          "$ref": "#/$defs/ReviewStatus"
        },
        {
          "type": "null"
        }
