    "transportRetryCount": {
      "default": 0,
      "minimum": 0,
      "title": "Transportretrycount",
      "type": "integer"
    },
    "usage": {
      "anyOf": [
        {
          "$ref": "#/$defs/Usage"
        },
        {
          "type": "null"
        }
      ],
      "default": null
