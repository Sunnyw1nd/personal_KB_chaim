    "RevisionInfo": {
      "additionalProperties": false,
      "properties": {
        "revisionId": {
          "pattern": "^revision-[0-9a-f]{16}$",
          "title": "Revisionid",
          "type": "string"
        },
        "fingerprintSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Fingerprintsha256",
          "type": "string"
        },
        "contentFingerprintSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Contentfingerprintsha256",
          "type": "string"
        },
        "assetFingerprintSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Assetfingerprintsha256",
          "type": "string"
        },
        "packageSha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Packagesha256"
        },
        "fingerprintVersion": {
          "minLength": 1,
          "title": "Fingerprintversion",
          "type": "string"
        }
      },
      "required": [
        "revisionId",
        "fingerprintSha256",
        "contentFingerprintSha256",
        "assetFingerprintSha256",
        "fingerprintVersion"
