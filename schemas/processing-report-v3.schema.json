{
  "$defs": {
    "AssetCompleteness": {
      "additionalProperties": false,
      "properties": {
        "expected": {
          "minimum": 0,
          "title": "Expected",
          "type": "integer"
        },
        "available": {
          "minimum": 0,
          "title": "Available",
          "type": "integer"
        },
        "missing": {
          "minimum": 0,
          "title": "Missing",
          "type": "integer"
        },
        "invalid": {
          "minimum": 0,
          "title": "Invalid",
          "type": "integer"
        },
        "completenessRate": {
          "maximum": 1,
          "minimum": 0,
          "title": "Completenessrate",
          "type": "number"
        },
        "missingAssetIds": {
          "items": {
            "type": "string"
          },
          "title": "Missingassetids",
          "type": "array"
        },
        "invalidAssetIds": {
          "items": {
            "type": "string"
          },
          "title": "Invalidassetids",
          "type": "array"
        }
      },
      "required": [
        "expected",
        "available",
        "missing",
        "invalid",
        "completenessRate",
        "missingAssetIds",
        "invalidAssetIds"
      ],
      "title": "AssetCompleteness",
      "type": "object"
    },
    "Message": {
