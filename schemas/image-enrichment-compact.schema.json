{
  "$defs": {
    "CompactAxis": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        }
      },
      "required": [
        "name",
        "unit"
      ],
      "title": "CompactAxis",
      "type": "object"
    },
    "CompactChart": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/CompactAxis"
          },
          "title": "Axes",
          "type": "array"
        },
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "imageType": {
          "const": "chart",
          "title": "Imagetype",
          "type": "string"
        },
        "keyFacts": {
          "items": {
            "type": "string"
          },
          "title": "Keyfacts",
          "type": "array"
        },
        "keyValues": {
          "items": {
            "type": "string"
          },
          "title": "Keyvalues",
          "type": "array"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "legends": {
          "items": {
            "type": "string"
          },
          "title": "Legends",
          "type": "array"
        },
        "series": {
          "items": {
            "type": "string"
          },
          "title": "Series",
          "type": "array"
        },
        "trends": {
          "items": {
            "type": "string"
          },
          "title": "Trends",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "description",
        "axes",
        "legends",
        "series",
        "trends",
        "keyValues",
        "keyFacts"
      ],
      "title": "CompactChart",
      "type": "object"
    },
    "CompactCode": {
      "additionalProperties": false,
      "properties": {
        "codeText": {
          "minLength": 1,
          "title": "Codetext",
          "type": "string"
        },
        "imageType": {
          "const": "code",
          "title": "Imagetype",
          "type": "string"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Language"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "codeText",
        "language"
      ],
      "title": "CompactCode",
      "type": "object"
    },
    "CompactDescription": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "imageType": {
          "enum": [
            "architecture_flow",
            "ui_screenshot",
            "photo_scene"
          ],
          "title": "Imagetype",
          "type": "string"
        },
        "keyFacts": {
          "items": {
            "type": "string"
          },
          "title": "Keyfacts",
          "type": "array"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "description",
        "keyFacts"
      ],
      "title": "CompactDescription",
      "type": "object"
    },
    "CompactTable": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Headers",
          "type": "array"
        },
        "imageType": {
          "const": "table",
          "title": "Imagetype",
          "type": "string"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "mergedCells": {
          "items": {
            "type": "string"
          },
          "title": "Mergedcells",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "minItems": 1,
          "title": "Rows",
          "type": "array"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "headers",
        "rows",
        "mergedCells"
      ],
      "title": "CompactTable",
      "type": "object"
    },
    "CompactText": {
      "additionalProperties": false,
      "properties": {
        "description": {
          "title": "Description",
          "type": "string"
        },
        "extractedText": {
          "title": "Extractedtext",
          "type": "string"
        },
        "imageType": {
          "enum": [
            "text_image",
            "decorative_text",
            "logo_mark"
          ],
          "title": "Imagetype",
          "type": "string"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "retrievalDecision": {
          "enum": [
            "include",
            "exclude",
            "manual_review"
          ],
          "title": "Retrievaldecision",
          "type": "string"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "extractedText",
        "description",
        "retrievalDecision"
      ],
      "title": "CompactText",
      "type": "object"
    },
    "CompactUncertain": {
      "additionalProperties": false,
      "properties": {
        "imageType": {
          "enum": [
            "uncertain",
            "other",
            "qr_code"
          ],
          "title": "Imagetype",
          "type": "string"
        },
        "knowledgeValue": {
          "enum": [
            "none",
            "low",
            "medium",
            "high",
            "context_dependent"
          ],
          "title": "Knowledgevalue",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "uncertainties": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Uncertainties",
          "type": "array"
        }
      },
      "required": [
        "knowledgeValue",
        "uncertainties",
        "imageType",
        "reason"
      ],
      "title": "CompactUncertain",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "architecture_flow": "#/$defs/CompactDescription",
      "chart": "#/$defs/CompactChart",
      "code": "#/$defs/CompactCode",
      "decorative_text": "#/$defs/CompactText",
      "logo_mark": "#/$defs/CompactText",
      "other": "#/$defs/CompactUncertain",
      "photo_scene": "#/$defs/CompactDescription",
      "qr_code": "#/$defs/CompactUncertain",
      "table": "#/$defs/CompactTable",
      "text_image": "#/$defs/CompactText",
      "ui_screenshot": "#/$defs/CompactDescription",
      "uncertain": "#/$defs/CompactUncertain"
    },
    "propertyName": "imageType"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/CompactCode"
    },
    {
      "$ref": "#/$defs/CompactDescription"
    },
    {
      "$ref": "#/$defs/CompactTable"
    },
    {
      "$ref": "#/$defs/CompactChart"
    },
    {
      "$ref": "#/$defs/CompactText"
    },
    {
      "$ref": "#/$defs/CompactUncertain"
    }
  ]
}
