{
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "revisionId": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Revisionid",
      "type": "string"
    },
    "parentRevisionId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parentrevisionid"
    },
    "binding": {
      "additionalProperties": true,
      "title": "Binding",
      "type": "object"
    },
    "originalResultSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Originalresultsha256",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "maxLength": 100000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Description"
    },
    "keyFacts": {
      "items": {
        "type": "string"
      },
      "maxItems": 1000,
      "title": "Keyfacts",
      "type": "array"
    },
    "codeText": {
      "anyOf": [
        {
          "maxLength": 500000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Codetext"
    },
    "createdAt": {
      "title": "Createdat",
      "type": "string"
    },
    "actor": {
      "enum": [
        "user",
        "codex_test"
      ],
      "title": "Actor",
      "type": "string"
    },
    "reviewStatus": {
      "const": "draft",
      "default": "draft",
      "title": "Reviewstatus",
      "type": "string"
    }
  },
  "required": [
    "revisionId",
    "binding",
    "originalResultSha256",
    "description",
    "keyFacts",
    "codeText",
    "createdAt",
    "actor"
  ],
  "title": "HumanRevision",
  "type": "object"
}
