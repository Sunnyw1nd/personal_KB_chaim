{
  "$defs": {
    "ReviewStatus": {
      "enum": [
        "pending",
        "needs_review",
        "approved",
        "rejected"
      ],
      "title": "ReviewStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "cacheKey": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Cachekey",
      "type": "string"
    },
    "createdAt": {
      "title": "Createdat",
      "type": "string"
    },
    "eventId": {
      "pattern": "^[0-9a-f]{32}$",
      "title": "Eventid",
      "type": "string"
    },
    "imageSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Imagesha256",
      "type": "string"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    },
    "reviewStatus": {
      "$ref": "#/$defs/ReviewStatus"
    },
    "reviewer": {
      "const": "user",
      "title": "Reviewer",
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    }
  },
  "required": [
    "schemaVersion",
    "cacheKey",
    "imageSha256",
    "reviewStatus",
    "reason",
    "reviewer",
    "createdAt",
    "eventId"
  ],
  "title": "QualityReviewDecision",
  "type": "object"
}
