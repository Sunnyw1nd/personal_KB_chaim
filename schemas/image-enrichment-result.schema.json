{
  "$defs": {
    "ChartAxis": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        }
      },
      "required": [
        "name"
      ],
      "title": "ChartAxis",
      "type": "object"
    },
    "ChartContent": {
      "additionalProperties": false,
      "properties": {
        "axes": {
          "items": {
            "$ref": "#/$defs/ChartAxis"
          },
          "title": "Axes",
          "type": "array"
        },
        "directObservations": {
          "items": {
            "type": "string"
          },
          "title": "Directobservations",
          "type": "array"
        },
        "inferences": {
          "items": {
            "type": "string"
          },
          "title": "Inferences",
          "type": "array"
        },
        "keyValues": {
          "items": {
            "type": "string"
          },
          "title": "Keyvalues",
          "type": "array"
        },
        "legends": {
          "items": {
            "type": "string"
          },
          "title": "Legends",
          "type": "array"
        },
        "series": {
          "items": {
            "type": "string"
          },
          "title": "Series",
          "type": "array"
        },
        "textualClaims": {
          "items": {
            "type": "string"
          },
          "title": "Textualclaims",
          "type": "array"
        },
        "trends": {
          "items": {
            "type": "string"
          },
          "title": "Trends",
          "type": "array"
        }
      },
      "title": "ChartContent",
      "type": "object"
    },
    "CodeContent": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Language"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "text"
      ],
      "title": "CodeContent",
      "type": "object"
    },
    "EnrichmentAction": {
      "enum": [
        "exclude_from_retrieval",
        "describe",
        "transcribe_text",
        "transcribe_code",
        "extract_table",
        "understand_chart",
        "ocr_and_vision",
        "decode_qr",
        "manual_review"
      ],
      "title": "EnrichmentAction",
      "type": "string"
    },
    "ImageType": {
      "enum": [
        "architecture_flow",
        "table",
        "chart",
        "code",
        "ui_screenshot",
        "text_image",
        "decorative_text",
        "qr_code",
        "photo_scene",
        "logo_mark",
        "other"
      ],
      "title": "ImageType",
      "type": "string"
    },
    "KnowledgeValue": {
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "context_dependent"
      ],
      "title": "KnowledgeValue",
      "type": "string"
    },
    "RetrievalDecision": {
      "enum": [
        "include",
        "exclude",
        "manual_review"
      ],
      "title": "RetrievalDecision",
      "type": "string"
    },
    "TableContent": {
      "additionalProperties": false,
      "properties": {
        "headers": {
          "items": {
            "type": "string"
          },
          "title": "Headers",
          "type": "array"
        },
        "mergedCells": {
          "items": {
            "type": "string"
          },
          "title": "Mergedcells",
          "type": "array"
        },
        "rows": {
          "items": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "title": "Rows",
          "type": "array"
        },
        "textRepresentation": {
          "minLength": 1,
          "title": "Textrepresentation",
          "type": "string"
        }
      },
      "required": [
        "textRepresentation"
      ],
      "title": "TableContent",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "action": {
      "$ref": "#/$defs/EnrichmentAction"
    },
    "chart": {
      "anyOf": [
        {
          "$ref": "#/$defs/ChartContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "code": {
      "anyOf": [
        {
          "$ref": "#/$defs/CodeContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "extractedText": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Extractedtext"
    },
    "imageType": {
      "$ref": "#/$defs/ImageType"
    },
    "keyFacts": {
      "items": {
        "type": "string"
      },
      "title": "Keyfacts",
      "type": "array"
    },
    "knowledgeValue": {
      "$ref": "#/$defs/KnowledgeValue"
    },
    "retrievalDecision": {
      "$ref": "#/$defs/RetrievalDecision"
    },
    "schemaVersion": {
      "const": "1.0.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "table": {
      "anyOf": [
        {
          "$ref": "#/$defs/TableContent"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "uncertainties": {
      "items": {
        "type": "string"
      },
      "title": "Uncertainties",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "schemaVersion",
    "imageType",
    "knowledgeValue",
    "action",
    "retrievalDecision"
  ],
  "title": "EnrichmentResult",
  "type": "object"
}
